# ── Virtual Environment ───────────────────────────────────────────────────────
# Don't copy venv — Docker installs fresh libraries from requirements.txt
venv/
.venv/

# ── Secrets ───────────────────────────────────────────────────────────────────
# NEVER put .env inside Docker — pass keys via -e flag in docker run command
.env

# ── Python Cache ──────────────────────────────────────────────────────────────
# Auto-generated by Python — not needed inside container
__pycache__/
*.pyc
*.pyo

# ── Test Cache ────────────────────────────────────────────────────────────────
.pytest_cache/

# ── Git ───────────────────────────────────────────────────────────────────────
# Git history not needed inside container
.git/
.gitignore

# ── Artifacts ─────────────────────────────────────────────────────────────────
# Planning docs not needed inside container
artifacts/
