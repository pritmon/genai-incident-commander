# ── Anthropic Claude API ──────────────────────────────────────────────────────
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── API Key (protects your endpoints) ────────────────────────────────────────
# Choose any strong random string. Callers must send: X-API-Key: <value>
# Leave blank to disable auth (local dev only)
API_KEY=your-strong-secret-key-here

# ── Optional Settings ─────────────────────────────────────────────────────────
# Claude model to use (default: claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# LOG_LEVEL=INFO
